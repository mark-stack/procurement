includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    paths:
        - app/

    # Level 10 is the highest level
    level: 5

    ignoreErrors:
    - '#never written, only read#'
    - '#Access to an undefined property#'

    excludePaths:
        - App/Jobs/AdminMaterialsImportSubJob2.php

