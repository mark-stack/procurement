APP_NAME=SteelNesting.com.au
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

ADMIN_EMAIL="mark.laravel.coder@gmail.com"

#In test mode, the scheduler runs every min, and 1 day = 1 min.
#In test mode, the scheduler runs every hour.
# Compresses every notification window from days to minutes and runs the schedules every minute.
# Local only - it now defaults to false, so production needs no line at all. Never set it on a
# deployment that mails real customers.
TEST_MODE=true

#Email domains registration accepts despite being personal addresses, comma separated.
#Ignored in production. For form fillers - see config/registration.php.
REGISTRATION_ALLOWED_EMAIL_DOMAINS=mailinator.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

NESTING_ITERATIONS=1000

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=procurement
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Left unset on purpose: config/session.php turns it on by itself when APP_ENV=production, and a
# Secure cookie is never sent over the plain http this file is set up for. Set it to true by hand
# only for a non-production box that is served over https.
# SESSION_SECURE_COOKIE=

# Off in production by default now (config/telescope.php). true turns the request recorder back on
# for an afternoon of chasing something down - it writes entries into the application's own database.
# While on, entries are pruned nightly to seven days (config/retention.php).
# TELESCOPE_ENABLED=

# How long an emailed magic link stays a working login, and how many times it may be followed.
# Both default in config/magiclink.php - see the reasoning there before shortening or lengthening.
# MAGICLINK_LOGIN_LIFETIME_MINUTES=720
# MAGICLINK_LOGIN_MAX_VISITS=3
# The activation welcome is sent once and is a customer's first way in, so it lives longer
# MAGICLINK_WELCOME_LIFETIME_MINUTES=10080
# MAGICLINK_WELCOME_MAX_VISITS=3

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="mark@steelnesting.com.au"
MAIL_FROM_NAME="Mark"
MAIL_ENCRYPTION=tls

# Whether the deadline reminders also email the project manager, on top of the nav bell.
# Off: the bell fills, no outbound mail. See config/notifications.php.
NOTIFICATIONS_MAIL_REMINDERS=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LOGIN_AVAILABLE="false"

# Billing
# "manual" is invoice-by-email and needs no keys - it is the default, and what the tests run on.
# "stripe" additionally needs the Stripe keys and a price id per plan below.
BILLING_DRIVER=manual
BILLING_TRIAL_DAYS=30
BILLING_CURRENCY=aud
BILLING_INVOICE_EMAIL="mark@steelnesting.com.au"
# Plan amounts in config/billing.php EXCLUDE GST, and we are the merchant of record, so the GST is
# ours to collect: this is on, the Stripe prices are created tax-exclusive, and Stripe Tax adds GST
# at the checkout. Off - which is what the code falls back to when this is unset, because a default
# must not assume Stripe Tax has been enabled on the account - charges the bare ex-GST figure and
# leaves the GST on it to come out of the fee. php artisan billing:check reports which it is.
BILLING_COLLECT_TAX=true

STRIPE_KEY=
STRIPE_SECRET=
# Required before BILLING_DRIVER=stripe - BillingServiceProvider refuses to boot the driver without
# it. Cashier leaves POST /stripe/webhook unsigned when it is empty, and that endpoint can grant a
# subscription to any business whose Stripe customer id the payload names.
STRIPE_WEBHOOK_SECRET=

# Price ids from the Stripe dashboard, one per card-paid plan in config/billing.php. A plan with no
# id here is not offered for sale, so a half-configured provider cannot take money for nothing -
# which also means a mistyped one withdraws the plan in silence. Run php artisan billing:check after
# setting these: it compares each id against Stripe for amount, currency, interval, tax behaviour
# and live/test mode. Only the weekly plan is paid by card - the annual one is invoiced, so Stripe
# never prices it.
STRIPE_PRICE_WEEKLY=

# AI template parser
# This is what sets a new customer up. An upload matching none of their templates is read here,
# tested with the real importer, and recorded as a template if it passes - so without a key every
# unrecognised spreadsheet becomes a failed attempt for an admin to finish by hand, which is the
# onboarding queue this replaced. Spreadsheet contents are sent to OpenAI when set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Writing an import template from a customer's own upload. Default on.
# False puts every unrecognised upload in front of an admin instead, without asking OpenAI anything.
TEMPLATE_LEARNING_ENABLED=true
# Attempts one business may make per hour. Each is two OpenAI calls and a full extraction, and what
# triggers one is a customer pressing upload - so a retried unreadable file has a ceiling.
TEMPLATE_LEARNING_HOURLY_LIMIT=5
# Days a failed attempt's copy of the customer's spreadsheet is kept, so the failure can be
# reproduced. The row outlives it; only their data goes. See templates:prune-samples.
TEMPLATE_LEARNING_SAMPLE_RETENTION_DAYS=30
