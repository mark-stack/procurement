APP_NAME=SteelNesting.com.au
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

ADMIN_EMAIL="mark.laravel.coder@gmail.com"

#In test mode, the scheduler runs every min, and 1 day = 1 min.
#In test mode, the scheduler runs every hour.
TEST_MODE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

NESTING_ITERATIONS=1000

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=procurement
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="mark@steelnesting.com.au"
MAIL_FROM_NAME="Mark"
MAIL_ENCRYPTION=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LOGIN_AVAILABLE="false"

# Billing
# "manual" is invoice-by-email and needs no keys - it is the default, and what the tests run on.
# "stripe" additionally needs the Stripe keys and a price id per plan below.
BILLING_DRIVER=manual
BILLING_TRIAL_DAYS=30
BILLING_CURRENCY=aud
BILLING_INVOICE_EMAIL="mark@steelnesting.com.au"
# Plan amounts in config/billing.php EXCLUDE GST. Turn this on and create the Stripe prices as
# tax-exclusive so Stripe Tax adds GST at the checkout; left off, the bare ex-GST figure is charged.
BILLING_COLLECT_TAX=false

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Price ids from the Stripe dashboard, one per plan in config/billing.php. A plan with no id here
# is not offered for sale, so a half-configured provider cannot take money for nothing.
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# AI template parser
# Optional. Without a key the parser still fills the form for any spreadsheet that matches an
# entry in config/TableTemplates.php - that part is deterministic - but it cannot suggest
# anything for one that matches none. Sample spreadsheet contents are sent to OpenAI when set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
