<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="ADMIN_EMAIL" value="mark.laravel.coder@gmail.com"/>
        <!--
            Billing runs on the manual driver in tests, so nothing can reach Stripe. Tests that need
            the Stripe driver bind a fake provider over App\Billing\Contracts\BillingProvider.
            Trial length pinned so a change to .env cannot move a test's expiry dates.
        -->
        <env name="BILLING_DRIVER" value="manual"/>
        <env name="BILLING_TRIAL_DAYS" value="30"/>
        <!--
            Empty, so the suite tests what production does. A developer who allows mailinator.com
            in their own .env for a form filler would otherwise silently turn off the test that
            says throwaway addresses cannot register. Tests that want the allowance set it
            themselves with config().
        -->
        <env name="REGISTRATION_ALLOWED_EMAIL_DOMAINS" value=""/>
        <!--
            The notification suite was written against test mode's minute-wide windows, and pins it
            here now that config/env.php defaults it off - a default that used to be true, so a
            production deploy that forgot the line mailed every customer once a minute.
        -->
        <env name="TEST_MODE" value="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
         <env name="DB_CONNECTION" value="sqlite"/>
         <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <!--
            No key, so nothing in the suite can reach OpenAI - and until the template test started
            asking it to read the extracted rows, something could: a developer with a real key in
            their own .env was billed for a real call every time one of those tests ran, and the
            assertions turned on whatever a model happened to say that afternoon.

            An absent key is a supported state everywhere it is read, so this is also the state
            worth testing. Tests that want an answer set the key and fake the HTTP response.
        -->
        <env name="OPENAI_API_KEY" value=""/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
